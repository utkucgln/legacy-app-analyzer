  "phases": { "explore": true, "access_check": true, "probe": false, "design": true, "report": true },
  "design": { "target_design_system": "Fluent UI React v9" },
  "ai": {
    "endpoint": "",
    "model": "",
    "endpoint_env": "AZURE_OPENAI_ENDPOINT",
    "model_env": "AZURE_OPENAI_DEPLOYMENT",
    "api_key_env": "AZURE_OPENAI_API_KEY",
    "runtime": "direct",
    "copilot": { "cli_path": null }
  },
  "output_dir": "D:\\modernisation\\ui-analysis-out"
